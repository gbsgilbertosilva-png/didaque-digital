rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function ehInstrutor() {
      return logado() && exists(/databases/$(database)/documents/instrutores/$(request.auth.uid));
    }

    // Documento de convite: só você mexe, pelo console do Firebase
    match /config/{doc} {
      allow read, write: if false;
    }

    // Cadastro de instrutores: exige o código de convite
    match /instrutores/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow create: if logado() && request.auth.uid == uid
        && request.resource.data.convite == get(/databases/$(database)/documents/config/convite).data.codigo;
      allow update, delete: if false;
    }

    // Classes
    match /classes/{codigo} {
      allow get: if logado();
      allow list: if logado() && resource.data.instrutorUid == request.auth.uid;
      allow create: if ehInstrutor() && request.resource.data.instrutorUid == request.auth.uid;
      allow update, delete: if logado() && resource.data.instrutorUid == request.auth.uid;

      // Alunos da classe (documento = nome do aluno na classe)
      match /alunos/{alunoId} {
        allow get: if logado() && exists(/databases/$(database)/documents/classes/$(codigo));
        allow list: if logado()
          && get(/databases/$(database)/documents/classes/$(codigo)).data.instrutorUid == request.auth.uid;
        allow create, update: if logado() && exists(/databases/$(database)/documents/classes/$(codigo));
        allow delete: if logado()
          && get(/databases/$(database)/documents/classes/$(codigo)).data.instrutorUid == request.auth.uid;
      }
    }
  }
}
